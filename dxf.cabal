cabal-version:       3.0
name:                dxf
version:             0.2.0.0
synopsis:            A DXF parser and printer, modelled on ezdxf
license:             BSD-3-Clause
license-file:        LICENSE
author:              Wesley Sales Massuda
maintainer:          wesley.massuda@gmail.com
build-type:          Simple
extra-source-files:  PERF.md

library dxf-checks
  visibility:       public
  exposed-modules:  Check
                    Check.Util
                    Check.Tags
                    Check.Doubles
                    Check.Document
                    Check.Oracle
                    Check.Group
                    Check.Samples
                    Check.Geometry
                    Check.Text
                    Check.Poly
                    Check.Hatch
                    Check.Dimension
                    Check.Misc
                    Check.Objects
                    Check.Settings
                    Check.Tables
                    Check.House
                    Check.Build
                    Check.Reals
  hs-source-dirs:   test
  build-depends:    base, bytestring, containers, text, directory, filepath, process, dxf
  default-language: Haskell2010
  ghc-options:      -O1

test-suite dxf-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test-main
  build-depends:    base, dxf-checks
  default-language: Haskell2010
  ghc-options:      -rtsopts

executable dxf-summary
  main-is:          Summary.hs
  hs-source-dirs:   app
  build-depends:    base, bytestring, dxf
  default-language: Haskell2010
  ghc-options:      -O2

executable dxf-bench
  main-is:          Bench.hs
  hs-source-dirs:   app
  build-depends:    base, bytestring, containers, deepseq, dxf, membudget
  default-language: Haskell2010
  ghc-options:      -O2 -rtsopts

executable dxf-write-bench
  main-is:          WriteBench.hs
  hs-source-dirs:   app
  build-depends:    base, bytestring, dxf
  default-language: Haskell2010
  ghc-options:      -O2 -rtsopts

library
  exposed-modules:  DXF
                    DXF.Vec
                    DXF.Tag
                    DXF.Number
                    DXF.Encoding
                    DXF.Tag.Text
                    DXF.Tag.Binary
                    DXF.Tag.Out
                    DXF.Tag.Double
                    DXF.Tag.Prim
                    DXF.Number.Lemire
                    DXF.Tag.Scan
                    DXF.Json
                    DXF.Codec
                    DXF.Header
                    DXF.Classes
                    DXF.Tables
                    DXF.Document
                    DXF.Parse
                    DXF.Print
                    DXF.Summary
                    DXF.Entity
                    DXF.Entity.Common
                    DXF.Entity.Types
                    DXF.Intern
                    DXF.Entity.Interned
                    DXF.Entity.FastKit
                    DXF.Entity.Fast
                    DXF.Entity.FastOut
                    DXF.Entity.Geometry
                    DXF.Entity.Text
                    DXF.Entity.Poly
                    DXF.Entity.Hatch
                    DXF.Entity.Dimension
                    DXF.Entity.Misc
                    DXF.Entity.Objects
                    DXF.Entity.Settings
                    DXF.Entity.Tables
                    DXF.Entity.Vars
                    DXF.Entity.Block
                    DXF.XData
                    DXF.Build.Entities
                    DXF.Build.Skeleton
                    DXF.Build
  build-depends:    base >=4.8 && <5, array, bytestring, containers, text, deepseq, linbuf, membudget
  hs-source-dirs:   src
  default-language: Haskell2010
  ghc-options:      -O2 -Wall -Wno-name-shadowing -Wno-unused-do-bind
