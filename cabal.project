packages: .


-- >>> shared profile (ghci-session tools/shared-profile.project; build-sharing step 2b, 2026-11-06)
-- One build profile for every package that ends up in a shared store: the cabal store hash of a unit moves with
-- -fobject-determinism, optimization, -rtsopts and -fspecialise-aggressively (not with -W* or -j), so a consumer
-- built with this block takes a library another consumer built, 0 units (docs/shared-store-audit.md section 3).
-- Dynamic-only is all or nothing: a vanilla consumer cannot load a dynamic-only library. Per-project flags go on
-- that project's own packages (`package NAME`), never up here. Moved by tools/shared-profile.sh, not by hand.
shared: True
library-vanilla: False
executable-dynamic: True
optimization: 2
program-options
  ghc-options: -fobject-determinism
-- <<< shared profile

-- build-sharing step 3: the libraries below come from the store at the commits of tools/snapshot/ (undo: git revert)
import: ../ghci-session/tools/snapshot/linbuf.project
import: ../ghci-session/tools/snapshot/membudget.project
import: ../ghci-session/tools/snapshot/portkit.project
import: ../ghci-session/tools/snapshot/linsys.project
import: ../ghci-session/tools/snapshot/linstream.project
import: ../ghci-session/tools/snapshot/geometry.project
