name:                dxf
version:             0.2.0.0
synopsis:            A DXF parser and printer, modelled on ezdxf
license:             BSD3
license-file:        LICENSE
author:              Wesley Sales Massuda
maintainer:          wesley.massuda@gmail.com
build-type:          Simple
cabal-version:       >=1.10
extra-source-files:  PERF.md

test-suite dxf-test
  type:             exitcode-stdio-1.0
  main-is:          Main.hs
  hs-source-dirs:   test
  other-modules:    Check, Check.Util, Check.Tags
  build-depends:    base, bytestring, containers, text, directory, process, dxf
  default-language: Haskell2010
  ghc-options:      -O1 -rtsopts

executable dxf-bench
  main-is:          Bench.hs
  hs-source-dirs:   app
  build-depends:    base, bytestring, dxf
  default-language: Haskell2010
  ghc-options:      -O2 -rtsopts

library
  exposed-modules:  DXF
                    DXF.Vec
                    DXF.Tag
                    DXF.Number
                    DXF.Encoding
                    DXF.Tag.Text
                    DXF.Tag.Binary
                    DXF.Tag.Out
                    DXF.Tag.Scan
  build-depends:    base >=4.8 && <5, bytestring, containers, text, deepseq
  hs-source-dirs:   src
  default-language: Haskell2010
  ghc-options:      -O2 -Wall -Wno-name-shadowing -Wno-unused-do-bind
