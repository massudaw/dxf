{
  "default": "dxf",
  "hygiene": false,
  "summarize_cmd": "GHS_PROVIDER=claude GHS_CLAUDE_SUMMARIZE_MODEL=claude-haiku-5-5 ghci-session summarize",
  "summarize_jobs": 4,
  "targets": {
    "dxf": {
      "units": [
        "lib:dxf",
        "test:dxf-test"
      ],
      "watch": [
        "src",
        "test"
      ],
      "modules": [
        "DXF",
        "Check"
      ],
      "test": {
        "expr": "Check.run"
      }
    }
  },
  "cabal_args": "--repl-options=-fobject-code --repl-options=-O1 --repl-options=-fno-ignore-interface-pragmas"
}
